DISCORD_TOKEN="<YOUR_TOKEN>"
GROQ_API_KEY="<YOUR_API_KEY>"

# Optional if you use -local flag
DB_URL="libsql://<DATABASE_URL>"
DB_TOKEN="<DATABASE_TOKEN>"

# Logging Configuration
LOG_ENABLED=true                    # Enable/disable all logging (true/false)
LOG_TO_DB=true                     # Enable database event logging (true/false)
LOG_LEVEL=info                     # Log level: debug, info, warn, error
LOG_ENCODING=json                  # Log format: json or console
EVENT_LOGGING_ENABLED=true         # Enable event database storage (true/false)
EVENT_RETENTION_DAYS=7             # Days to retain events in database

# Database Log Level (controls which events are stored)
DB_LOG_LEVEL=info                  # none, error, warn, info, debug, all

# AI Provider Configuration
# Retry Configuration
AI_MAX_RETRIES=2                   # Number of retries on empty/error (0-10)
AI_RETRY_INITIAL_DELAY_MS=500      # Initial retry delay in milliseconds (100-5000)
AI_RETRY_MAX_DELAY_MS=5000         # Maximum retry delay in milliseconds (1000-30000)
AI_RETRY_BACKOFF=2.0               # Exponential backoff multiplier (1.0-5.0)
AI_RETRY_ON_EMPTY=true             # Retry on empty responses (true/false)
AI_RETRY_ON_ERROR=true             # Retry on API errors (true/false)

# Fallback Configuration
AI_FALLBACK_ENABLED=true           # Enable provider fallback (true/false)
AI_MIN_RESPONSE_LENGTH=1           # Minimum valid response length (1-100)

# AI Model Configuration
GROQ_MODEL="openai/gpt-oss-20b"                                # Groq chat model
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"  # Groq vision model

# Ollama Configuration (optional fallback provider)
OLLAMA_ENABLED=false               # Enable Ollama fallback (true/false)
OLLAMA_API_URL="http://localhost:11434"  # Ollama API URL
OLLAMA_MODEL="dolphin3"            # Ollama chat model
OLLAMA_VISION_MODEL="llava"        # Ollama vision model
